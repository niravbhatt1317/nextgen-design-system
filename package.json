{
  "name": "motadata-react-library",
  "version": "0.1.0",
  "description": "Custom UI kit for SaaS platform development and custom app development",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md,json}\"",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "test-storybook",
    "test:storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"npm run build-storybook --quiet\" \"wait-on tcp:127.0.0.1:6006 && npm run test:storybook\"",
    "prepare": "(husky || true) && npm run build",
    "prepublishOnly": "npm run build",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish",
    "chromatic": "npx chromatic",
    "generate-icons": "node scripts/generate-icons.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "catalog": "node scripts/extract-capabilities.mjs --write",
    "find": "node scripts/extract-capabilities.mjs --find",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:tokens:strict": "node scripts/check-tokens.mjs --strict",
    "check:tokens:report": "node scripts/check-tokens.mjs --markdown",
    "pre-pipeline-check": "bash scripts/pre-pipeline-check.sh",
    "validate": "npm run pre-pipeline-check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pranjalgupta-motadata/ai-ready-design-system.git"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "library",
    "typescript",
    "tailwind",
    "radix",
    "accessible",
    "motadata"
  ],
  "author": "Motadata",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pranjalgupta-motadata/ai-ready-design-system/issues"
  },
  "homepage": "https://pranjalgupta-motadata.github.io/ai-ready-design-system",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.13.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "react-resizable-panels": "^4.4.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@changesets/cli": "^2.27.10",
    "@chromatic-com/storybook": "^4.1.3",
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.16.0",
    "@fontsource/inter": "^5.2.8",
    "@playwright/test": "^1.58.0",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@storybook/addon-a11y": "^10.1.7",
    "@storybook/addon-coverage": "^3.0.0",
    "@storybook/addon-docs": "^10.1.7",
    "@storybook/addon-links": "^10.1.7",
    "@storybook/react": "^10.1.7",
    "@storybook/react-vite": "^10.1.7",
    "@storybook/test-runner": "^0.24.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/jest-image-snapshot": "^6.4.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.3",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-istanbul": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "autoprefixer": "^10.4.20",
    "axe-playwright": "^2.2.2",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-sonarjs": "^3.0.6",
    "eslint-plugin-storybook": "^10.1.7",
    "globals": "^15.13.0",
    "happy-dom": "^20.0.11",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-image-snapshot": "^6.5.1",
    "jsdom": "^27.3.0",
    "lint-staged": "^15.2.10",
    "lucide-static": "^1.27.0",
    "playwright": "^1.57.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "size-limit": "^11.1.6",
    "storybook": "^10.1.7",
    "tailwindcss": "^3.4.15",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-istanbul": "^7.2.1",
    "vite-plugin-lib-inject-css": "^2.1.1",
    "vitest": "^4.0.15",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "500 KB"
    },
    {
      "path": "dist/styles.css",
      "limit": "100 KB"
    }
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.0.0"
}
