# Temporary files
tmp
temp
*.tmp
*.temp

# Bundle analysis
stats.html
stats.json

# Chromatic
chromatic-archives/

# TypeScript incremental compilation
*.tsbuildinfo

# Optional npm cache
.npm

# Size limit
.size-snapshot.json
# Visual Test Snapshots - Diff images
.storybook/__image_snapshots__/__diff_output__/

# Playwright
playwright-report/
e2e-results/
test-results/

# SonarQube
# Both of these are regenerated by every `npm test` run, so tracking them means
# a 130KB diff on every commit that says nothing. SonarCloud does not run
# against this repository anyway - it runs against the developer-owned Azure
# DevOps repo this library came from.
.scannerwork/
sonar-report.xml

# JUnit reports
junit.xml

# Scratch scripts
# Node resolves `playwright` from the project's node_modules, so a throwaway
# measuring script has to live in the project root to run at all - and then
# `git add -A` picks it up. One did reach a commit before being caught.
.tmp-*

# Claude Code local settings (machine-specific)
.claude/settings.local.json
